{
  "name": "qai-classroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run model:prepare && npm run classroom",
    "poc": "node --env-file-if-exists=.env demo/server.mjs --poc",
    "demo": "node demo/server.mjs --simulate",
    "live": "node --env-file-if-exists=.env demo/server.mjs --live",
    "test": "node --test demo/*.test.mjs",
    "model:prepare": "node demo/model/prepare.mjs",
    "classroom": "node --env-file-if-exists=.env demo/server.mjs --local-ai",
    "test:model": "node demo/model/evaluate.mjs"
  },
  "engines": {
    "node": ">=22.16"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/ita": "1.0.0",
    "katex": "0.19.1",
    "lucide-static": "1.70.0",
    "markdown-it": "15.0.3",
    "onnxruntime-web": "1.22.0",
    "pdfjs-dist": "6.4.299",
    "qrcode": "^1.5.4",
    "tesseract.js": "7.0.0",
    "unpdf": "1.9.1"
  }
}
