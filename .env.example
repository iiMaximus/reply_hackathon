# Copy to .env. Secrets are read only by the backend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=4173
HOST=0.0.0.0
DATABASE_PATH=data/classroom.sqlite
# Optional locally: a persistent random secret is generated in data/.session-secret.
# Set a long random secret in your deployment environment.
SESSION_SECRET=
# Enable only behind a trusted reverse proxy that overwrites forwarding headers.
TRUST_PROXY=0
